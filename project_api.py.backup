from typing import Any

from fastapi import APIRouter, HTTPException
from pydantic import BaseModel, Field

from app.project_store import (
    create_project,
    get_project,
    get_project_report,
    list_projects,
)

router = APIRouter(prefix="/api/v1/projects", tags=["Projects"])


class CreateProjectRequest(BaseModel):
    name: str = Field(min_length=1, max_length=120)


@router.post("", status_code=201, summary="Create a new project")
def create_new_project(payload: CreateProjectRequest) -> dict[str, Any]:
    try:
        return create_project(payload.name)
    except ValueError as exc:
        raise HTTPException(status_code=422, detail=str(exc)) from exc


@router.get("", summary="List saved projects")
def get_all_projects() -> list[dict[str, Any]]:
    return list_projects()


@router.get("/{project_id}", summary="Open a saved project")
def open_project(project_id: str) -> dict[str, Any]:
    project = get_project(project_id)

    if project is None:
        raise HTTPException(status_code=404, detail="Project not found.")

    return project


@router.get(
    "/{project_id}/reports/{report_id}",
    summary="Open a saved analysis report",
)
def open_saved_report(
    project_id: str,
    report_id: str,
) -> dict[str, Any]:
    report = get_project_report(project_id, report_id)

    if report is None:
        raise HTTPException(
            status_code=404,
            detail="Report not found in this project.",
        )

    return report


