
"""Feature engineering and automatic data-cleaning API endpoints."""

from io import BytesIO
from pathlib import Path
from typing import Any
import logging

import pandas as pd
from fastapi import APIRouter, File, Form, HTTPException, UploadFile
from fastapi.responses import StreamingResponse

from app.feature_engineering import engineer_features
from app.project_store import (
    create_project,
    get_or_create_project,
    get_project,
    save_project_report,
)

logger = logging.getLogger(__name__)

router = APIRouter(
    prefix="/api/v1/datasets",
    tags=["Feature Engineering"],
)

MAX_UPLOAD_BYTES = 25 * 1024 * 1024
ALLOWED_EXTENSIONS = {".csv", ".xlsx", ".xls"}


async def _read_feature_dataset(
    file: UploadFile,
) -> tuple[str, bytes, pd.DataFrame]:
    """Validate and read a dataset without changing its original bytes."""
    filename = Path(file.filename or "").name
    extension = Path(filename).suffix.lower()

    if not filename or extension not in ALLOWED_EXTENSIONS:
        raise HTTPException(
            status_code=400,
            detail="Upload a CSV, XLSX, or XLS dataset.",
        )

    content = await file.read(MAX_UPLOAD_BYTES + 1)

    if len(content) > MAX_UPLOAD_BYTES:
        raise HTTPException(
            status_code=413,
            detail="File exceeds the 25 MB upload limit.",
        )

    if not content:
        raise HTTPException(
            status_code=400,
            detail="The uploaded file is empty.",
        )

    try:
        if extension == ".csv":
            df = pd.read_csv(BytesIO(content))
        elif extension == ".xlsx":
            df = pd.read_excel(BytesIO(content), engine="openpyxl")
        else:
            df = pd.read_excel(BytesIO(content), engine="xlrd")

    except ImportError as exc:
        raise HTTPException(
            status_code=500,
            detail=(
                "An Excel dependency is missing. Install openpyxl "
                "for XLSX files or xlrd for XLS files."
            ),
        ) from exc

    except (
        UnicodeDecodeError,
        pd.errors.ParserError,
        pd.errors.EmptyDataError,
        ValueError,
        OSError,
    ) as exc:
        raise HTTPException(
            status_code=400,
            detail="Could not read the dataset. Check its format and contents.",
        ) from exc

    if not df.columns.is_unique:
        raise HTTPException(
            status_code=400,
            detail="Column names must be unique.",
        )

    if df.empty or len(df.columns) == 0:
        raise HTTPException(
            status_code=400,
            detail="Dataset must contain rows and columns.",
        )

    return filename, content, df


def _resolve_feature_project(
    filename: str,
    project_id: str | None,
    new_project: bool,
) -> dict[str, Any]:
    """Select a project or resolve one named after the dataset."""
    project_name = " ".join(Path(filename).stem.split()).strip()
    project_name = project_name[:120] or "Untitled Dataset"

    if new_project:
        project = create_project(project_name)
    elif project_id:
        project = get_project(project_id)

        if project is None:
            raise HTTPException(
                status_code=404,
                detail="Selected project was not found.",
            )
    else:
        project = get_or_create_project(project_name)

    if not isinstance(project, dict) or not project.get("id"):
        raise HTTPException(
            status_code=500,
            detail="Could not resolve a valid project.",
        )

    return project


@router.post(
    "/feature-engineer",
    summary="Automatically clean and engineer a dataset",
    description=(
        "Automatically fills missing values, replaces infinite numeric "
        "values, removes identical columns, and optionally applies other "
        "feature transformations. Saves a report to a project and returns "
        "the transformed dataset as a separate CSV download."
    ),
    responses={
        200: {"description": "Cleaned and engineered CSV download."},
        400: {"description": "Invalid dataset or transformation options."},
        404: {"description": "Selected project was not found."},
        413: {"description": "Uploaded file exceeds 25 MB."},
        500: {"description": "Cleaning or report saving failed."},
    },
)
async def feature_engineer_dataset(
    file: UploadFile = File(...),

    # Automatic cleaning defaults.
    drop_duplicates: bool = Form(False),
    fill_numeric_missing: bool = Form(True),
    fill_categorical_missing: bool = Form(True),
    numeric_fill_method: str = Form("median"),
    numeric_fill_value: float = Form(0),
    categorical_fill_method: str = Form("mode"),
    drop_identical_columns: bool = Form(True),

    # Optional feature transformations.
    encode_categoricals: bool = Form(False),
    extract_date_features: bool = Form(False),

    # Project management.
    project_id: str | None = Form(default=None),
    new_project: bool = Form(default=False),
) -> StreamingResponse:
    """Clean a dataset, save a report, and return a downloadable CSV."""
    try:
        filename, original_content, df = await _read_feature_dataset(file)

        try:
            transformed, summary = engineer_features(
                df,
                drop_duplicates=drop_duplicates,
                fill_numeric_missing=fill_numeric_missing,
                fill_categorical_missing=fill_categorical_missing,
                encode_categoricals=encode_categoricals,
                extract_date_features=extract_date_features,
                numeric_fill_method=numeric_fill_method,
                numeric_fill_value=numeric_fill_value,
                categorical_fill_method=categorical_fill_method,
                drop_identical_columns=drop_identical_columns,
            )
        except (TypeError, ValueError) as exc:
            raise HTTPException(
                status_code=400,
                detail=f"Could not clean or engineer features: {exc}",
            ) from exc

        # Resolve a project only after transformations succeed.
        project = _resolve_feature_project(
            filename=filename,
            project_id=project_id,
            new_project=new_project,
        )

        options = {
            "drop_duplicates": drop_duplicates,
            "fill_numeric_missing": fill_numeric_missing,
            "fill_categorical_missing": fill_categorical_missing,
            "numeric_fill_method": numeric_fill_method,
            "numeric_fill_value": numeric_fill_value,
            "categorical_fill_method": categorical_fill_method,
            "drop_identical_columns": drop_identical_columns,
            "encode_categoricals": encode_categoricals,
            "extract_date_features": extract_date_features,
        }

        report_data = {
            "filename": filename,
            "report_type": "automatic_data_cleaning_and_feature_engineering",
            "options": options,
            "summary": summary,
            "original_file_preserved": True,
            "original_file_size_bytes": len(original_content),
        }

        try:
            saved_report = save_project_report(
                project_id=project["id"],
                dataset_name=filename,
                report=report_data,
            )
        except (TypeError, ValueError) as exc:
            raise HTTPException(
                status_code=500,
                detail=f"Could not save the cleaning report: {exc}",
            ) from exc

        if saved_report is None:
            raise HTTPException(
                status_code=500,
                detail="The cleaning report was not saved.",
            )

        # Return a separate CSV; never overwrite the original upload.
        output = transformed.to_csv(index=False).encode("utf-8-sig")
        download_name = f"{Path(filename).stem}_cleaned.csv"

        headers = {
            "Content-Disposition": f'attachment; filename="{download_name}"',
            "X-Project-Id": str(project["id"]),
            "X-Saved-Report-Id": str(saved_report["id"]),
            "X-Feature-Engineering-Status": "completed",
            "X-Cleaning-Mode": "automatic",
        }

        return StreamingResponse(
            BytesIO(output),
            media_type="text/csv; charset=utf-8",
            headers=headers,
        )

    except HTTPException:
        raise

    except Exception as exc:
        logger.exception("Automatic data cleaning failed")
        raise HTTPException(
            status_code=500,
            detail=(
                "Data cleaning failed unexpectedly. "
                "Check the server terminal for details."
            ),
        ) from exc

    finally:
        await file.close()
